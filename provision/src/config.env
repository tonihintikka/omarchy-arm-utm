# Template. build-omarchy-arm.sh writes the real version to $W/provision/config.env
# with the questionnaire values (or the defaults with --yes), and embeds it in
# the provisioning ISO. This file is only used for manual runs.
VM_USER="builder"
VM_PASSWORD="builder"
VM_FULLNAME="Omarchy ARM"
VM_EMAIL="user@example.com"
VM_HOSTNAME="omarchy"
VM_TIMEZONE="Europe/Helsinki"
VM_KEYMAP="fi"
VM_XKB="fi"
VM_LOCALE="en_US.UTF-8"
VM_LOCALE_EXTRA="fi_FI.UTF-8"
DISK="/dev/vda"
DIST_OLD_USER="builder"
DIST_NEW_USER="omarchy"
HACER_TOOLS="yes"
HACER_LIBRES="yes"
